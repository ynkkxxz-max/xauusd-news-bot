# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_OR_CHANNEL_ID_HERE

# Operating Mode
# Set to 'true' to run live simulation when no active internet API or during weekends
SIMULATION_MODE=false

# Gemini AI (natural-language Khmer market analysis)
# Get a key at https://aistudio.google.com/apikey and paste it here (never commit the real key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-latest
# Set to false to disable Gemini and use the built-in rule-based analyzer
USE_GEMINI=true
# Throttling (protects the free-tier quota from HTTP 429 bursts)
# GEMINI_MIN_INTERVAL = min seconds between two Gemini calls
# GEMINI_COOLDOWN = seconds to pause Gemini after the quota is exhausted
GEMINI_MIN_INTERVAL=20
GEMINI_COOLDOWN=900

# Timezone (Default Cambodia UTC+7)
TIMEZONE=Asia/Phnom_Penh

# Notification Schedule
DAILY_PRICE_ALERT_HOUR=7
DAILY_PRICE_ALERT_MINUTE=0

# Breaking-news alert rate limit: minimum seconds between two alerts (default 2 hours)
BREAKING_ALERT_MIN_GAP=7200

# ---- AI fallback providers (optional backups when Gemini fails/quota exhausted) ----
# List the providers to enable, in priority order, comma-separated.
# Supported names: groq, deepseek, openai, qwen, grok, kimi, glm, claude
# Example: AI_FALLBACKS=groq,deepseek,claude
AI_FALLBACKS=

# Add a key only for the providers you listed above (never commit real keys).
# GROQ_API_KEY=        (free key: https://console.groq.com)
# DEEPSEEK_API_KEY=    (https://platform.deepseek.com)
# OPENAI_API_KEY=      (https://platform.openai.com)
# QWEN_API_KEY=        (https://www.alibabacloud.com/en/product/modelstudio)
# GROK_API_KEY=        (https://x.ai/api)
# KIMI_API_KEY=        (https://platform.moonshot.ai)
# GLM_API_KEY=         (https://z.ai)
# ANTHROPIC_API_KEY=   (https://console.anthropic.com)

# Optional model overrides (defaults are sensible per provider):
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini
# QWEN_MODEL=qwen-plus
# GROK_MODEL=grok-4-fast
# KIMI_MODEL=moonshot-v1-8k
# GLM_MODEL=glm-4.5-air
# ANTHROPIC_MODEL=claude-sonnet-4-5
