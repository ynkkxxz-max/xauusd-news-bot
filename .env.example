# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_OR_CHANNEL_ID_HERE

# Operating Mode
# Set to 'true' to run live simulation when no active internet API or during weekends
SIMULATION_MODE=false

# Gemini AI (natural-language Khmer market analysis)
# Get a key at https://aistudio.google.com/apikey and paste it here (never commit the real key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
# Set to false to disable Gemini and use the built-in rule-based analyzer
USE_GEMINI=true
# Throttling (protects the free-tier quota from HTTP 429 bursts)
# GEMINI_MIN_INTERVAL = min seconds between two Gemini calls
# GEMINI_COOLDOWN = seconds to pause Gemini after the quota is exhausted
GEMINI_MIN_INTERVAL=20
GEMINI_COOLDOWN=900

# Timezone (Default Cambodia UTC+7)
TIMEZONE=Asia/Phnom_Penh

# Notification Schedule
DAILY_PRICE_ALERT_HOUR=7
DAILY_PRICE_ALERT_MINUTE=0

# Breaking-news alert rate limit: minimum seconds between two alerts (default 2 hours)
BREAKING_ALERT_MIN_GAP=7200
